@using Items.Api.Dtos
@using KlondikeTR.Helpers


<div type="button" @onclick="@Select" class="d-flex flex-column m-1">
    <div class="item-name-size badge bg-secondary text-wrap text-break ps-1 pe-1 d-flex align-items-center justify-content-center">@ItemName(ItemDto?.Name)</div>
    <img class="item-img-size border border-1 border-secondary rounded mt-1" src="@ItemDto?.Icon?.FileBinary.ToImgSrc()" alt="@ItemDto?.Name" />
</div>


@code {

    [Parameter]
    public TradableItemDto ItemDto { get; set; } = new();

    [Parameter]
    public Action<TradableItemDto>? OnSelect { get; set; }

    void Select()
    {
        OnSelect?.Invoke(ItemDto);
    }

    string? ItemName(string? input)
    {
        const int maxNameLength = 28;
        return input?.Length < maxNameLength ? input : input?[..maxNameLength];
    }
}
