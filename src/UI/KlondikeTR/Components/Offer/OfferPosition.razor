@using Offers.Api.Dtos
@using KlondikeTR.Enums

<div class="border-bottom border-1 border-secondary bg-light p-2">
    
    <div class="d-flex flex-row mt-2">
        <h3 class="text-secondary font-monospace p-1 m-1">@PositionNumber</h3>
        
        <select class="form-select m-1 ms-2 w-50" aria-label="Select Position Type" @bind="_offerPositionType">
            <option selected value="@OfferPositionType.WithPriceRate.ToString()">With Price Rate</option>
            <option value="@OfferPositionType.WithoutPriceRate.ToString()">Without Price Rate</option>
            <option value="@OfferPositionType.Selling.ToString()">Selling</option>
            <option value="@OfferPositionType.Buying.ToString()">Buying</option>
            <option value="@OfferPositionType.ByCollectionItems.ToString()">By CollectionItems with Price Rate</option>
            <option value="@OfferPositionType.ByCollectionItemsWithoutPriceRate.ToString()">By CollectionItems without Price Rate</option>
            <option value="@OfferPositionType.ExactOffer.ToString()">Exact Offer</option>
        </select>
        
        <button type="button" class="btn-close ms-auto m-1" aria-label="Close"></button>
    </div>
    
    <div class="mt-2">
        
        <div class="d-flex flex-row">

            <div class="m-2 p-2 border" style="width: 582px">
                
                @for (var rowIndex = 0; rowIndex < _offerItemsBuy.Count + MAX_ITEMS_IN_ROW; rowIndex += MAX_ITEMS_IN_ROW)
                {
                    <div class="d-flex flex-row">

                        @if (_offerItemsBuy.Count == 0)
                        {
                            <OfferItem OnAddOfferItem="AddItemToBuyOfferPosition"/>
                        }
                        else
                        {
                            foreach (var item in GetItemsForRow(_offerItemsBuy, rowIndex))
                            {
                                <OfferItem OfferItemDto="item" OnAddOfferItem="AddItemToBuyOfferPosition" />
                            }
                        }

                    </div>
                }

            </div>

            
            <div class="m-2 p-2 border" style="width: 582px">

                @for (var rowIndex = 0; rowIndex < _offerItemsSell.Count + MAX_ITEMS_IN_ROW; rowIndex += MAX_ITEMS_IN_ROW)
                {
                    <div class="d-flex flex-row">

                        @if (_offerItemsSell.Count == 0)
                        {
                            <OfferItem OnAddOfferItem="AddItemToSellOfferPosition"/>
                        }
                        else
                        {
                            foreach (var item in GetItemsForRow(_offerItemsSell, rowIndex))
                            {
                                <OfferItem OfferItemDto="item" OnAddOfferItem="AddItemToSellOfferPosition"/>
                            }
                        }

                    </div>
                }

            </div>

        </div>
    </div>

    <textarea class="form-control form-control-sm text-dark" rows="2" placeholder="Enter message for this Offer Position" @bind="_offerPositionMessage"></textarea>

</div>

@code {
    [Parameter]
    public Action<OfferPositionDto>? OnAddOfferPosition { get; set; }

    [Parameter]
    public int PositionNumber { get; set; }

    private string? _offerPositionType;
    private string? _offerPositionMessage;

    private OfferPositionDto _offerPosition = new();

    private readonly List<OfferItemDto> _offerItemsBuy = new();
    private readonly List<OfferItemDto> _offerItemsSell = new();

    private const int MAX_ITEMS_IN_ROW = 5;

    private void AddItemToBuyOfferPosition(OfferItemDto offerItem)
    {
        _offerItemsBuy.Add(offerItem);

        _offerPosition.OfferItems = _offerItemsBuy;
        StateHasChanged();
    }

    private void AddItemToSellOfferPosition(OfferItemDto offerItem)
    {
        _offerItemsSell.Add(offerItem);

        _offerPosition.OfferItems = _offerItemsSell;
        StateHasChanged();
    }

    private List<OfferItemDto> GetItemsForRow(List<OfferItemDto> items, int rowIndex)
    {
        return items.Skip(rowIndex).Take(MAX_ITEMS_IN_ROW).ToList();
    }
}
